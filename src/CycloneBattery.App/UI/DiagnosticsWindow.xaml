<Window x:Class="CycloneBattery.App.UI.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyclone Battery — Diagnostics"
        Width="720"
        Height="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Foreground="#555555"
                   Text="Read-only hardware investigation. Nothing here writes to the controller. Copy the text below into a support request if the battery is not detected." />

        <TextBox Grid.Row="1"
                 x:Name="OutputBox"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 AcceptsReturn="True" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666666" Margin="0,0,12,0" />
            <Button x:Name="RunAgainButton" Content="Run again" MinWidth="100" Padding="8,4" Margin="0,0,8,0" />
            <Button x:Name="CopyButton" Content="Copy" MinWidth="80" Padding="8,4" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Save…" MinWidth="80" Padding="8,4" Margin="0,0,8,0" />
            <Button x:Name="CloseButton" Content="Close" MinWidth="80" Padding="8,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
