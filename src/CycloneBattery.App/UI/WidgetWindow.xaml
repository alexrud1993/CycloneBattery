<Window x:Class="CycloneBattery.App.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyclone Battery"
        Width="200"
        Height="72"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="#EE202124"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="OnMouseLeftButtonDown">

        <Grid Margin="12,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Header row: generic controller glyph, name, charging indicator -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <Canvas Width="18" Height="14" Margin="0,0,6,0">
                    <Path Data="M4,1 H14 A3.5,3.5 0 0 1 17.5,4.5 V9.5 A3.5,3.5 0 0 1 14,13 H4 A3.5,3.5 0 0 1 0.5,9.5 V4.5 A3.5,3.5 0 0 1 4,1 Z"
                          Fill="#CCFFFFFF" />
                    <Path Data="M4.5,4.5 h1.2 v1.3 h1.3 v1.2 h-1.3 v1.3 h-1.2 v-1.3 h-1.3 v-1.2 h1.3 z"
                          Fill="#202124" />
                    <Ellipse Canvas.Left="12.2" Canvas.Top="4.6" Width="1.6" Height="1.6" Fill="#202124" />
                    <Ellipse Canvas.Left="12.2" Canvas.Top="7.4" Width="1.6" Height="1.6" Fill="#202124" />
                </Canvas>

                <TextBlock Text="Cyclone 2"
                           Foreground="#F2FFFFFF"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Path Grid.Row="0" Grid.Column="1"
                  Data="M6,0 L1.5,7 H4.5 L3,12 L9.5,4.2 H6.2 Z"
                  Fill="#FFC107"
                  Width="10" Height="12"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Visibility="{Binding ShowCharging, Converter={StaticResource BoolToVisibility}}" />

            <!-- Battery row -->
            <ProgressBar Grid.Row="2" Grid.Column="0"
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         BorderThickness="0"
                         Background="#2EFFFFFF"
                         Foreground="{Binding ProgressBrush}"
                         Value="{Binding ProgressValue, Mode=OneWay}" />

            <TextBlock Grid.Row="2" Grid.Column="1"
                       Margin="8,0,0,0"
                       Text="{Binding BatteryText}"
                       Foreground="#F2FFFFFF"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>
