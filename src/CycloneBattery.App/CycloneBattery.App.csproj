<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CycloneBattery.App
    ==================
    WPF shell: tray icon, mini widget, settings window, diagnostics window and the Windows
    integrations (autostart, notifications, single instance).

    No protocol or HID code lives here; everything comes from CycloneBattery.Core through the
    interfaces defined there.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CycloneBattery.App</RootNamespace>
    <AssemblyName>CycloneBattery</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
    <!-- Self-contained single-file publishing is configured in scripts/publish-win-x64.ps1 -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CycloneBattery.Core\CycloneBattery.Core.csproj" />
  </ItemGroup>

</Project>
